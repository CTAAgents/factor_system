# FTS 环境变量配置
# 复制此文件为 .env 并填入真实值
# 注意: .env 已在 .gitignore 中，不会提交到 Git

# ── LLM 后端（二选一） ──

# 后端选择器（可选，不设置时自动检测 OPENAI_API_KEY / ANTHROPIC_API_KEY）
# 可选值: openai / anthropic / mock
# FTS_LLM_BACKEND=openai

# 方案一：OpenAI 兼容 API（推荐 DeepSeek）
OPENAI_API_KEY=sk-your-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 方案二：Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── FTS 配置（可选，以下为默认值） ──

FTS_MEMORY_DIR=memory
FTS_ELITE_DIR=memory/knowledge/factors/stocks_elite
FTS_FUTURES_ELITE_DIR=memory/knowledge/factors/futures_elite
FTS_DEFAULT_MARKET=futures
FTS_MAX_WORKERS=4
FTS_LOG_LEVEL=INFO
FTS_LOG_FILE=
FTS_CONFIG_FILE=config/settings.yaml
FTS_EVOLUTION_MODE=hybrid

# ── 服务器配置（可选） ──

# FTS_UI_HOST=127.0.0.1
# FTS_UI_PORT=9100

# ── HuggingFace 模型缓存（TextEmbedder 本地离线加载，可选） ──
# HF_HOME 指向本地模型缓存目录（huggingface_hub 标准结构 hub/models--*）；
# HF_ENDPOINT 仅下载时使用，国内网络走 hf-mirror 镜像（运行时 local_files_only 不联网）。
HF_HOME=D:\Models\huggingface
HF_ENDPOINT=https://hf-mirror.com